# ==============================================================================
# Environment Configuration - Multi-Tenant Team Chat + Task Management SaaS
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# Single Tenant Mode (Set to true for single-tenant / on-premise deployments)
SINGLE_TENANT=false
DEFAULT_TENANT_SUBDOMAIN=acme

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Control Database + Provisioning Host)
# Note: The database user MUST have CREATE DATABASE privileges to provision tenant DBs.
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=root
DB_CONTROL_NAME=tenant_control
DB_SSL=false
DB_POOL_MAX=10

# Secret key used to encrypt/decrypt tenant database credentials stored in control DB
DB_ENCRYPTION_KEY=supersecret32characterkeyforaes!

# ------------------------------------------------------------------------------
# Redis Configuration (Presence, Typing indicators, Socket.IO adapter, BullMQ)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# JWT Authentication Secrets & Expiration
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your-access-token-jwt-secret-key-at-least-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-token-jwt-secret-key-at-least-32-chars
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# Storage Service Configuration
# STORAGE_DRIVER: 'local' (development disk folder) or 's3' (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# S3 / Cloudflare R2 Credentials (Active when STORAGE_DRIVER=s3)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET_NAME=team-saas-attachments
S3_PUBLIC_DOMAIN=https://cdn.example.com

# ------------------------------------------------------------------------------
# Web Push (VAPID) Configuration for PWA Push Notifications
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=BExampleVapidPublicKeyHere1234567890abcdef
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@example.com

# ------------------------------------------------------------------------------
# Tenant Domain Resolution Settings
# Subdomain pattern for multi-tenancy (e.g. acme.app.localhost or acme.app.com)
# ------------------------------------------------------------------------------
BASE_DOMAIN=localhost
